; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Powdered World Engine"
run/main_scene="uid://ins8vgen1wrn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")

[autoload]

SandInfo="*uid://c5rmjbdsvxn7d"
SandInfoCS="*uid://co545rbd16tk6"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Powdered World Engine"

[file_customization]

folder_colors={
"res://PowderedWorldEngine/Assets/": "orange",
"res://PowderedWorldEngine/Scenes/": "blue",
"res://PowderedWorldEngine/Scripts/": "red"
}

